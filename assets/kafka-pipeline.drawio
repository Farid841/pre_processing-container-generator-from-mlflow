<mxfile host="app.diagrams.net"><diagram name="Kafka pipeline" id="kafka"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Kafka pipeline: two containers, one intermediate topic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Preprocessing (data processing) and AI model run as separate containers, connected through Kafka&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="-30" width="1000" height="60" as="geometry"/></mxCell><mxCell id="t_in" value="&lt;b&gt;Kafka topic&lt;/b&gt;&lt;br&gt;fink_alerts&lt;br&gt;&lt;i&gt;ZTF alerts (Avro)&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;direction=south;whiteSpace=wrap;html=1;fontSize=12;align=center;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="170" height="110" as="geometry"/></mxCell><mxCell id="c_pre" value="Preprocessing container (data processing)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="250" y="50" width="440" height="320" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;1.&lt;/b&gt; Consume a batch of alerts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="270" y="95" width="400" height="38" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;2.&lt;/b&gt; Decode Avro (schema file or SCHEMA_TOPIC), drop cutouts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="270" y="149" width="400" height="38" as="geometry"/></mxCell><mxCell id="ep1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;3.&lt;/b&gt; &lt;b&gt;pre_processing(alert)&lt;/b&gt; → feature vector" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="270" y="203" width="400" height="38" as="geometry"/></mxCell><mxCell id="ep2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;4.&lt;/b&gt; Produce &lt;i&gt;{objectId, candid, features}&lt;/i&gt; (JSON)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="270" y="257" width="400" height="38" as="geometry"/></mxCell><mxCell id="ep3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;5.&lt;/b&gt; Commit offsets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="270" y="311" width="400" height="38" as="geometry"/></mxCell><mxCell id="ep4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t_mid" value="&lt;b&gt;Kafka topic&lt;/b&gt;&lt;br&gt;&amp;lt;name&amp;gt;-preprocessed&lt;br&gt;&lt;i&gt;features (JSON)&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;direction=south;whiteSpace=wrap;html=1;fontSize=12;align=center;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="150" width="190" height="110" as="geometry"/></mxCell><mxCell id="c_mod" value="AI model container" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="960" y="50" width="460" height="320" as="geometry"/></mxCell><mxCell id="m0" value="&lt;b&gt;1.&lt;/b&gt; Consume a batch (BATCH_SIZE / BATCH_TIMEOUT_MS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="980" y="95" width="420" height="38" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;2.&lt;/b&gt; Extract the feature vectors" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="980" y="149" width="420" height="38" as="geometry"/></mxCell><mxCell id="em1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m0" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;3.&lt;/b&gt; POST &lt;b&gt;/invocations&lt;/b&gt; → mlflow models serve :8080" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="980" y="203" width="420" height="38" as="geometry"/></mxCell><mxCell id="em2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;4.&lt;/b&gt; Produce &lt;i&gt;{result, source: {objectId, candid}}&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="980" y="257" width="420" height="38" as="geometry"/></mxCell><mxCell id="em3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;5.&lt;/b&gt; Commit offsets &lt;b&gt;only if the call succeeded&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="980" y="311" width="420" height="38" as="geometry"/></mxCell><mxCell id="em4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t_out" value="&lt;b&gt;Kafka topic&lt;/b&gt;&lt;br&gt;&amp;lt;name&amp;gt;-results&lt;br&gt;&lt;i&gt;predictions&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;direction=south;whiteSpace=wrap;html=1;fontSize=12;align=center;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1460" y="150" width="170" height="110" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_in" target="c_pre"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_pre" target="t_mid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_mid" target="c_mod"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_mod" target="t_out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_pre" value="&lt;b&gt;Light and fast.&lt;/b&gt; pre_processing() runs in-process (no HTTP hop). A failing alert is logged and skipped. The container also exposes a REST API on :8000." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="250" y="410" width="440" height="90" as="geometry"/></mxCell><mxCell id="n_mid" value="&lt;b&gt;Why the split?&lt;/b&gt; Features are stored in this topic: if the model fails, they are &lt;b&gt;replayed&lt;/b&gt;, never recomputed." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="410" width="250" height="90" as="geometry"/></mxCell><mxCell id="n_mod" value="&lt;b&gt;Slowest and most resource-hungry step.&lt;/b&gt; The model container can be scaled on its own, without touching the preprocessing." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="410" width="460" height="90" as="geometry"/></mxCell><mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;strokeColor=#999999;" edge="1" parent="1" source="n_pre" target="c_pre"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;strokeColor=#999999;" edge="1" parent="1" source="n_mid" target="t_mid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;strokeColor=#999999;" edge="1" parent="1" source="n_mod" target="c_mod"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
